<!doctype html>
<html lang="en" data-motion-set="limited" data-landing="intan">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#0e0e0e">
  <meta name="description" content="{{ site.names[0] }} and {{ site.names[1] }} are getting married in {{ site.city }} on {{ site.weddingDate | weddingDate }}.">
  <title>{{ site.names | join(" & ") }} — {{ site.titleSuffix }}</title>
  <link rel="preload" href="fonts/GreatVibes-Regular-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="styles.css">
  <script defer src="background-config.js"></script>
  <script defer src="photos/catalog.js"></script>
  <script defer src="script.js"></script>
</head>
<body>
  <a class="skip-link" href="#main-content">Skip to content</a>

  <!-- A fixed tabletop behind the page. JavaScript adds and shuffles postcards lazily. -->
  <div class="tabletop" aria-hidden="true">
    <div class="table-light"></div>
    <div class="postcard-field"><div class="postcard-plane" id="postcard-plane"></div></div>
    <div class="readability-veil"></div>
  </div>

  <header class="header">
    <nav class="nav" aria-label="Wedding website navigation">
      <button class="nav-toggle" type="button" aria-label="Wedding navigation" aria-expanded="false" aria-controls="nav-links"><span class="nav-current">Home</span><span class="nav-chevron" aria-hidden="true"><svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m4 6 4 4 4-4"/></svg></span></button>
      <div class="nav-links" id="nav-links">
{% for id in sections %}
{% set block = collections.weddingSections | sectionById(id) %}
      <a class="nav-link{% if loop.first %} is-active{% endif %}" href="#{{ block.data.id }}"{% if loop.first %} aria-current="location"{% endif %}>{{ block.data.nav }}</a>
{% endfor %}
      </div>
    </nav>
  </header>

  <div class="font-tools" hidden>
    <button class="font-toggle" type="button" aria-label="Try different fonts" aria-expanded="false" aria-controls="font-panel" title="Try different fonts">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9.5 3-.6 2.2-1.6.9-2.2-.6-2.5 4.3 1.6 1.6v1.8l-1.6 1.6 2.5 4.3 2.2-.6 1.6.9.6 2.2h5l.6-2.2 1.6-.9 2.2.6 2.5-4.3-1.6-1.6v-1.8l1.6-1.6-2.5-4.3-2.2.6-1.6-.9-.6-2.2z"/><circle cx="12" cy="12" r="3"/></svg>
    </button>
    <div class="font-panel" id="font-panel" role="dialog" aria-labelledby="font-panel-title" hidden>
      <p class="font-panel-title" id="font-panel-title">Try the typography</p>
      <label for="headline-font">Opening headline</label>
      <select id="headline-font">
        <option value="">Great Vibes · current</option>
        <option value="syne">Syne Bold</option>
        <option value="aboreto">Aboreto</option>
        <option value="fraunces">Fraunces Bold</option>
        <option value="prata">Prata</option>
        <option value="playfair">Playfair Display</option>
      </select>
      <label for="body-font">Body copy</label>
      <select id="body-font">
        <option value="">Current fonts</option>
        <option value="poppins">Poppins</option>
        <option value="zilla">Zilla Slab</option>
      </select>
      <button class="font-reset" type="button">Reset fonts</button>
    </div>
  </div>

  <main id="main-content">
{{ content | safe }}
  </main>

  <footer class="footer"><span>{{ site.names | join(" & ") }}</span><span>{{ site.city }} · {{ site.weddingDate | weddingDate }}</span></footer>
</body>
</html>
